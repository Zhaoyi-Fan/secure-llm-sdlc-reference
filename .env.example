# Primary validated path: LM Studio's OpenAI-compatible local endpoint.
LLM_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_COMPATIBLE_MODEL=qwen/qwen3.6-27b
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MAX_TOKENS=1024

# Optional Ollama fallback. Set LLM_PROVIDER=ollama to use it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Loopback defaults keep model traffic on this machine. A remote base URL sends
# prompts and tool results to that remote endpoint.

# Required: set at least 32 random bytes. One local option:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=900

DB_PATH=./supportassist.db

# Never enable this on a shared or public deployment. Tests request traces
# directly without changing this setting.
EXPOSE_DEBUG_TRACE=false
