# Local by default. If you point this at a remote Ollama server, prompts and
# tool results will leave this machine.
OLLAMA_BASE_URL=http://localhost:11434

# Verified Ollama tag; replace it with another tag you have pulled if needed.
OLLAMA_MODEL=qwen3.5:4b

# Required: set at least 32 random bytes. One local option:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=900

DB_PATH=./supportassist.db

# Never enable this on a shared or public deployment. Tests request traces
# directly without changing this setting.
EXPOSE_DEBUG_TRACE=false
