# Local LLM (Ollama) -- no API key needed, nothing leaves your machine.
OLLAMA_BASE_URL=http://localhost:11434

# Set this to a Qwen 3.6 tag you have actually pulled.
# Run `ollama list` to see the exact names available on your machine, then
# pick a size for your hardware (see the tier table in the README) and paste
# the real tag here. The value below is only a placeholder.
OLLAMA_MODEL=qwen3.6

# Dev-only signing secret. Do not reuse this in any real deployment.
JWT_SECRET=dev-only-not-for-production

DB_PATH=./supportassist.db
